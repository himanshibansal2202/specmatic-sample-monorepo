{
  "id": "backend-rest-python-fastapi",
  "application_type": "backend",
  "protocol": "rest",
  "language": "python",
  "framework": "fastapi",
  "data_layer": "in-memory",
  "integration_mode": "cli",
  "specmaticRuntime": {
    "artifact": "io.specmatic.enterprise:executable-all",
    "version": "1.19.1",
    "source": "maven-central",
    "invocation": "java -jar"
  },
  "contract_version": "5.0",
  "port": 8080,
  "test_command": "pytest test -v -s",
  "install_command": "pip install -r requirements.txt",
  "generated_files": [
    ".dockerignore",
    ".github/workflows/ci.yml",
    ".gitignore",
    ".specmatic-sample-manifest.json",
    "Dockerfile",
    "README.md",
    "assets/specmatic-order-backend-architecture.gif",
    "requirements.txt",
    "scripts/download_specmatic.py",
    "scripts/run_contract_tests.py",
    "specmatic.yaml",
    "src/order_api/__init__.py",
    "src/order_api/app.py",
    "src/order_api/config.py",
    "src/order_api/models.py",
    "src/order_api/store.py",
    "test/test_contract.py"
  ],
  "testCoverage": {
    "level1_none": { "tests": 31, "passed": 31, "failed": 0 },
    "level2_positiveOnly": { "tests": 74, "passed": 74, "failed": 0 },
    "level3_all": { "tests": 293, "passed": 293, "failed": 0 },
    "shipped_level": "all"
  },
  "reports": {
    "formats": ["html", "ctrf"],
    "outputDirectory": "build/reports/specmatic",
    "coverageGovernance": {
      "minCoveragePercentage": 68,
      "maxMissedOperationsInSpec": 10,
      "enforce": true
    }
  },
  "infraEndpoints": ["/health", "/openapi.json", "/docs", "/redoc"],
  "coverageExclusionMode": "filter",
  "learnings": [
    "Specmatic Enterprise 1.19.1 generated 293 passing full-resiliency tests for this contract, while API coverage measured 68% because the contract has 404 and 422 response variants that are declared but not selected by generated examples. Governance is enforced at the measured threshold: minCoveragePercentage 68 and maxMissedOperationsInSpec 10.",
    "Specmatic Enterprise 1.19.1 reported that endpoint discovery URLs were not exposed for this FastAPI app. The sample keeps OpenAPI coverage governance enforced from the measured contract test report and excludes generated infrastructure endpoints with the runtime-accepted OpenAPI filter."
  ]
}
